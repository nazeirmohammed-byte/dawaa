// Identity plus the pharmacy operations slice (catalog, stock, purchasing, sales, finance, settings).
// SQL Server has no Prisma enums; constrained strings live in infra/sql/004_checks.sql and 005_ops_checks.sql.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  type          String    @db.NVarChar(32)
  dbMode        String    @default("SHARED") @db.NVarChar(32)
  status        String    @default("TRIAL") @db.NVarChar(32)
  tradeNameAr   String    @db.NVarChar(200)
  tradeNameEn   String?   @db.NVarChar(200)
  licenseNumber String?   @db.NVarChar(100)
  phone         String?   @db.NVarChar(20)
  email         String?   @db.NVarChar(320)
  featureFlags  String    @default("[]") @db.NVarChar(Max)
  trialEndsAt         DateTime? @db.DateTime2
  branchLimit         Int       @default(1)
  verificationStatus  String    @default("VALID") @db.NVarChar(16)
  ownerName           String    @default("") @db.NVarChar(200)
  addressLine         String    @default("") @db.NVarChar(300)
  pharmacistName      String    @default("") @db.NVarChar(200)
  pharmacistLicense   String    @default("") @db.NVarChar(100)
  readOnly            Boolean   @default(false)
  supportNotes        String    @default("") @db.NVarChar(1000)
  createdAt     DateTime  @default(now()) @db.DateTime2
  createdBy     String?   @db.UniqueIdentifier
  updatedAt     DateTime  @updatedAt @db.DateTime2
  updatedBy     String?   @db.UniqueIdentifier
  rowVersion    Unsupported("timestamp")?

  branches        Branch[]
  users           User[]
  roles           Role[]
  permissions     Permission[]
  rolePermissions RolePermission[]
  userBranchRoles UserBranchRole[]
  refreshSessions RefreshSession[]
  auditLogs          AuditLog[]
  devices            Device[]
  operationalSignals OperationalSignal[]
  receiptDrafts      ReceiptDraft[]
  categories         Category[]
  products           Product[]
  stockLots          StockLot[]
  stockMovements     StockMovement[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  purchaseLines      PurchaseLine[]
  customers          Customer[]
  sales              Sale[]
  saleLines          SaleLine[]
  ledgerAccounts     LedgerAccount[]
  journalEntries     JournalEntry[]
  journalLines       JournalLine[]
  expenses           Expense[]
  pharmacySettings   PharmacySetting[]
  priceLists         PriceList[]
  priceActivations   BranchPriceActivation[]
  productPrices      ProductPrice[]
  exchangeRates      ExchangeRate[]
  priceBatches       PriceListChangeBatch[]
  priceHistories     PriceHistory[]

  @@map("Tenants")
}

model Branch {
  id           String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId     String   @db.UniqueIdentifier
  code         String   @db.NVarChar(32)
  nameAr       String   @db.NVarChar(200)
  nameEn       String?  @db.NVarChar(200)
  isHeadOffice Boolean  @default(false)
  state        String?  @db.NVarChar(100)
  city         String?  @db.NVarChar(100)
  phone        String?  @db.NVarChar(20)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.DateTime2
  createdBy    String?  @db.UniqueIdentifier
  updatedAt    DateTime @updatedAt @db.DateTime2
  updatedBy    String?  @db.UniqueIdentifier
  rowVersion   Unsupported("timestamp")?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userBranchRoles UserBranchRole[]
  devices         Device[]
  receiptDrafts   ReceiptDraft[]
  stockLots       StockLot[]
  stockMovements  StockMovement[]
  purchaseOrders  PurchaseOrder[]
  sales             Sale[]
  expenses          Expense[]
  priceActivations  BranchPriceActivation[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("Branches")
}

model User {
  id           String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId     String   @db.UniqueIdentifier
  email        String?  @db.NVarChar(320)
  phone        String?  @db.NVarChar(20)
  passwordHash String   @db.NVarChar(255)
  pinHash      String?  @db.NVarChar(255)
  displayName  String   @db.NVarChar(200)
  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  lastLoginAt  DateTime? @db.DateTime2
  failedLogins Int       @default(0)
  lockedAt      DateTime? @db.DateTime2
  forceOtp      Boolean   @default(false)
  otpHash       String?   @db.NVarChar(255)
  otpExpiresAt  DateTime? @db.DateTime2
  createdAt    DateTime  @default(now()) @db.DateTime2
  createdBy    String?  @db.UniqueIdentifier
  updatedAt    DateTime @updatedAt @db.DateTime2
  updatedBy    String?  @db.UniqueIdentifier
  rowVersion   Unsupported("timestamp")?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchRoles     UserBranchRole[]
  refreshSessions RefreshSession[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@map("Users")
}

model Role {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId  String   @db.UniqueIdentifier
  code      String   @db.NVarChar(64)
  nameAr    String   @db.NVarChar(200)
  nameEn    String   @db.NVarChar(200)
  isSystem  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now()) @db.DateTime2
  createdBy String?  @db.UniqueIdentifier
  updatedAt DateTime @updatedAt @db.DateTime2
  updatedBy String?  @db.UniqueIdentifier
  rowVersion Unsupported("timestamp")?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rolePermissions RolePermission[]
  userBranchRoles UserBranchRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("Roles")
}

model Permission {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId  String   @db.UniqueIdentifier
  code      String   @db.NVarChar(100)
  nameAr    String   @db.NVarChar(200)
  nameEn    String   @db.NVarChar(200)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now()) @db.DateTime2
  createdBy String?  @db.UniqueIdentifier
  updatedAt DateTime @updatedAt @db.DateTime2
  updatedBy String?  @db.UniqueIdentifier
  rowVersion Unsupported("timestamp")?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rolePermissions RolePermission[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("Permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId     String   @db.UniqueIdentifier
  roleId       String   @db.UniqueIdentifier
  permissionId String   @db.UniqueIdentifier
  createdAt    DateTime @default(now()) @db.DateTime2
  createdBy    String?  @db.UniqueIdentifier
  updatedAt    DateTime @updatedAt @db.DateTime2
  updatedBy    String?  @db.UniqueIdentifier
  rowVersion   Unsupported("timestamp")?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  permission Permission @relation(fields: [tenantId, permissionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId])
  @@map("RolePermissions")
}

model UserBranchRole {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId  String   @db.UniqueIdentifier
  userId    String   @db.UniqueIdentifier
  branchId  String   @db.UniqueIdentifier
  roleId    String   @db.UniqueIdentifier
  createdAt DateTime @default(now()) @db.DateTime2
  createdBy String?  @db.UniqueIdentifier
  updatedAt DateTime @updatedAt @db.DateTime2
  updatedBy String?  @db.UniqueIdentifier
  rowVersion Unsupported("timestamp")?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, userId, branchId, roleId])
  @@index([tenantId])
  @@map("UserBranchRoles")
}

model RefreshSession {
  id           String    @id @default(uuid()) @db.UniqueIdentifier
  tenantId     String    @db.UniqueIdentifier
  userId       String    @db.UniqueIdentifier
  tokenHash    String    @db.NVarChar(128)
  expiresAt    DateTime  @db.DateTime2
  revokedAt    DateTime? @db.DateTime2
  replacedById String?   @db.UniqueIdentifier
  userAgent    String?   @db.NVarChar(400)
  ipAddress    String?   @db.NVarChar(64)
  createdAt    DateTime  @default(now()) @db.DateTime2
  createdBy    String?   @db.UniqueIdentifier
  updatedAt    DateTime  @updatedAt @db.DateTime2
  updatedBy    String?   @db.UniqueIdentifier
  rowVersion   Unsupported("timestamp")?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tokenHash])
  @@map("RefreshSessions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId   String   @db.UniqueIdentifier
  actorId    String?  @db.UniqueIdentifier
  action     String   @db.NVarChar(100)
  entityType String   @db.NVarChar(100)
  entityId   String?  @db.UniqueIdentifier
  details    String?  @db.NVarChar(Max)
  branchId   String?  @db.UniqueIdentifier
  ipAddress  String?  @db.NVarChar(64)
  oldJson    String?  @db.NVarChar(Max)
  newJson    String?  @db.NVarChar(Max)
  createdAt  DateTime @default(now()) @db.DateTime2
  createdBy  String?  @db.UniqueIdentifier
  updatedAt  DateTime @updatedAt @db.DateTime2
  updatedBy  String?  @db.UniqueIdentifier
  rowVersion Unsupported("timestamp")?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("AuditLogs")
}

model Device {
  id         String    @id @default(uuid()) @db.UniqueIdentifier
  tenantId   String    @db.UniqueIdentifier
  branchId   String    @db.UniqueIdentifier
  name       String    @db.NVarChar(200)
  isActive   Boolean   @default(true)
  isDeleted  Boolean   @default(false)
  lastSyncAt DateTime? @db.DateTime2
  createdAt  DateTime  @default(now()) @db.DateTime2
  createdBy  String?   @db.UniqueIdentifier
  updatedAt  DateTime  @updatedAt @db.DateTime2
  updatedBy  String?   @db.UniqueIdentifier
  rowVersion Unsupported("timestamp")?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("Devices")
}

/// Seeded operations board for the demo tenant. Live stock and sales replace this in later phases.
model OperationalSignal {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId   String   @db.UniqueIdentifier
  branchId   String?  @db.UniqueIdentifier
  lane       String   @db.NVarChar(32)
  severity   String   @db.NVarChar(16)
  code       String   @db.NVarChar(64)
  titleAr    String   @db.NVarChar(200)
  titleEn    String   @db.NVarChar(200)
  detailAr   String   @db.NVarChar(500)
  detailEn   String   @db.NVarChar(500)
  figureAr   String   @db.NVarChar(40)
  figureEn   String   @db.NVarChar(40)
  sortOrder  Int
  createdAt  DateTime @default(now()) @db.DateTime2
  createdBy  String?  @db.UniqueIdentifier
  updatedAt  DateTime @updatedAt @db.DateTime2
  updatedBy  String?  @db.UniqueIdentifier
  rowVersion Unsupported("timestamp")?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, lane, sortOrder])
  @@map("OperationalSignals")
}

/// One sample 58 mm receipt so the print preview is tenant data, not a hardcoded price in the UI.
model ReceiptDraft {
  id            String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId      String   @db.UniqueIdentifier
  branchId      String   @db.UniqueIdentifier
  receiptNo     String   @db.NVarChar(32)
  cashierName   String   @db.NVarChar(200)
  soldAt        DateTime @db.DateTime2
  linesJson     String   @db.NVarChar(Max)
  subtotal      Decimal  @db.Decimal(18, 2)
  discount      Decimal  @db.Decimal(18, 2)
  total         Decimal  @db.Decimal(18, 2)
  paid          Decimal  @db.Decimal(18, 2)
  changeDue     Decimal  @db.Decimal(18, 2)
  paymentMethod String   @db.NVarChar(32)
  createdAt     DateTime @default(now()) @db.DateTime2
  createdBy     String?  @db.UniqueIdentifier
  updatedAt     DateTime @updatedAt @db.DateTime2
  updatedBy     String?  @db.UniqueIdentifier
  rowVersion    Unsupported("timestamp")?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("ReceiptDrafts")
}

model Category {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId   String   @db.UniqueIdentifier
  nameAr     String   @db.NVarChar(200)
  nameEn     String   @db.NVarChar(200)
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.DateTime2
  createdBy  String?  @db.UniqueIdentifier
  updatedAt  DateTime @updatedAt @db.DateTime2
  updatedBy  String?  @db.UniqueIdentifier
  rowVersion Unsupported("timestamp")?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products Product[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("Categories")
}

model Product {
  id           String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId     String   @db.UniqueIdentifier
  categoryId   String   @db.UniqueIdentifier
  sku          String   @db.NVarChar(64)
  nameAr       String   @db.NVarChar(200)
  nameEn       String   @db.NVarChar(200)
  genericName  String   @db.NVarChar(200)
  form         String   @db.NVarChar(80)
  strength     String   @db.NVarChar(80)
  reorderLevel Int
  sellPrice    Decimal  @db.Decimal(18, 2)
  costPrice    Decimal  @db.Decimal(18, 2)
  costUsd      Decimal? @db.Decimal(18, 2)
  isControlled Boolean  @default(false)
  isLocal      Boolean  @default(true)
  trackSerial  Boolean  @default(false)
  masterCode   String?  @db.NVarChar(64)
  gtin         String?  @db.NVarChar(32)
  shelfLifeMonths Int?
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.DateTime2
  createdBy    String?  @db.UniqueIdentifier
  updatedAt    DateTime @updatedAt @db.DateTime2
  updatedBy    String?  @db.UniqueIdentifier
  rowVersion   Unsupported("timestamp")?

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category      Category        @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  lots          StockLot[]
  movements     StockMovement[]
  purchaseLines PurchaseLine[]
  saleLines     SaleLine[]
  prices        ProductPrice[]
  priceHistories PriceHistory[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("Products")
}

model StockLot {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId   String   @db.UniqueIdentifier
  branchId   String   @db.UniqueIdentifier
  productId  String   @db.UniqueIdentifier
  batchNo        String    @db.NVarChar(64)
  expiry         DateTime  @db.DateTime2
  manufacturedAt DateTime? @db.DateTime2
  serialNo       String?   @db.NVarChar(64)
  unitCode       String    @default("BASE") @db.NVarChar(32)
  bonusQty       Int       @default(0)
  qtyBase        Int
  location       String    @db.NVarChar(100)
  createdAt  DateTime @default(now()) @db.DateTime2
  createdBy  String?  @db.UniqueIdentifier
  updatedAt  DateTime @updatedAt @db.DateTime2
  updatedBy  String?  @db.UniqueIdentifier
  rowVersion Unsupported("timestamp")?

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch     Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  product    Product         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  movements  StockMovement[]

  @@unique([tenantId, id])
  @@index([tenantId, productId, expiry])
  @@map("StockLots")
}

model StockMovement {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId  String   @db.UniqueIdentifier
  branchId  String   @db.UniqueIdentifier
  productId String   @db.UniqueIdentifier
  lotId     String   @db.UniqueIdentifier
  type      String   @db.NVarChar(32)
  qtyBase   Int
  note      String   @db.NVarChar(300)
  refType   String   @db.NVarChar(32)
  refId     String?  @db.UniqueIdentifier
  createdAt DateTime @default(now()) @db.DateTime2
  createdBy String?  @db.UniqueIdentifier
  updatedAt DateTime @updatedAt @db.DateTime2
  updatedBy String?  @db.UniqueIdentifier
  rowVersion Unsupported("timestamp")?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch  Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  product Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  lot     StockLot @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("StockMovements")
}

model Supplier {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId  String   @db.UniqueIdentifier
  nameAr    String   @db.NVarChar(200)
  nameEn    String   @db.NVarChar(200)
  phone     String?  @db.NVarChar(20)
  city      String?  @db.NVarChar(100)
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now()) @db.DateTime2
  createdBy String?  @db.UniqueIdentifier
  updatedAt DateTime @updatedAt @db.DateTime2
  updatedBy String?  @db.UniqueIdentifier
  rowVersion Unsupported("timestamp")?

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders   PurchaseOrder[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("Suppliers")
}

model PurchaseOrder {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId   String   @db.UniqueIdentifier
  branchId   String   @db.UniqueIdentifier
  supplierId String   @db.UniqueIdentifier
  docNo      String   @db.NVarChar(32)
  status     String   @db.NVarChar(32)
  total      Decimal  @db.Decimal(18, 2)
  orderedAt  DateTime @db.DateTime2
  createdAt  DateTime @default(now()) @db.DateTime2
  createdBy  String?  @db.UniqueIdentifier
  updatedAt  DateTime @updatedAt @db.DateTime2
  updatedBy  String?  @db.UniqueIdentifier
  rowVersion Unsupported("timestamp")?

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch   Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  supplier Supplier       @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  lines    PurchaseLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, docNo])
  @@index([tenantId])
  @@map("PurchaseOrders")
}

model PurchaseLine {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId   String   @db.UniqueIdentifier
  purchaseId String   @db.UniqueIdentifier
  productId  String   @db.UniqueIdentifier
  qty        Int
  unitCost   Decimal  @db.Decimal(18, 2)
  lineTotal  Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now()) @db.DateTime2
  createdBy  String?  @db.UniqueIdentifier
  updatedAt  DateTime @updatedAt @db.DateTime2
  updatedBy  String?  @db.UniqueIdentifier
  rowVersion Unsupported("timestamp")?

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase PurchaseOrder @relation(fields: [tenantId, purchaseId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  product  Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("PurchaseLines")
}

model Customer {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId  String   @db.UniqueIdentifier
  nameAr    String   @db.NVarChar(200)
  nameEn    String   @db.NVarChar(200)
  phone     String?  @db.NVarChar(20)
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now()) @db.DateTime2
  createdBy String?  @db.UniqueIdentifier
  updatedAt DateTime @updatedAt @db.DateTime2
  updatedBy String?  @db.UniqueIdentifier
  rowVersion Unsupported("timestamp")?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("Customers")
}

model Sale {
  id            String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId      String   @db.UniqueIdentifier
  branchId      String   @db.UniqueIdentifier
  docNo         String   @db.NVarChar(32)
  customerName  String   @db.NVarChar(200)
  cashierName   String   @db.NVarChar(200)
  soldAt        DateTime @db.DateTime2
  subtotal      Decimal  @db.Decimal(18, 2)
  discount      Decimal  @db.Decimal(18, 2)
  total         Decimal  @db.Decimal(18, 2)
  paid          Decimal  @db.Decimal(18, 2)
  changeDue     Decimal  @db.Decimal(18, 2)
  paymentMethod String   @db.NVarChar(32)
  status        String   @db.NVarChar(32)
  createdAt     DateTime @default(now()) @db.DateTime2
  createdBy     String?  @db.UniqueIdentifier
  updatedAt     DateTime @updatedAt @db.DateTime2
  updatedBy     String?  @db.UniqueIdentifier
  rowVersion    Unsupported("timestamp")?

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  lines  SaleLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, docNo])
  @@index([tenantId, soldAt])
  @@map("Sales")
}

model SaleLine {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  tenantId  String   @db.UniqueIdentifier
  saleId    String   @db.UniqueIdentifier
  productId String   @db.UniqueIdentifier
  nameAr    String   @db.NVarChar(200)
  nameEn    String   @db.NVarChar(200)
  qty       Int
  unitPrice          Decimal  @db.Decimal(18, 2)
  lineTotal          Decimal  @db.Decimal(18, 2)
