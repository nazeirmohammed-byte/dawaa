# Copy to .env. Never commit .env.
# Local SQL Server, no containers. See docs/DECISIONS.md.

# Runtime login (DML only, subject to row-level security)
DATABASE_URL=sqlserver://127.0.0.1:1433;database=dawaa;user=dawaa_app;password=CHANGE_ME;encrypt=true;trustServerCertificate=true

# Migrations, RLS scripts, and seed (database owner)
MIGRATE_DATABASE_URL=sqlserver://127.0.0.1:1433;database=dawaa;user=dawaa_migrator;password=CHANGE_ME;encrypt=true;trustServerCertificate=true

ACCESS_TOKEN_SECRET=change-me-access-token-secret-min-32-chars
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Local demo owner created by the seed. Not a production secret.
SEED_OWNER_EMAIL=owner@demo.dawaa.local
SEED_OWNER_PASSWORD=Dawaa-Dev-2026!

# Local platform owner. Not a production secret.
PLATFORM_ADMIN_EMAIL=admin@dawaa.local
PLATFORM_ADMIN_PASSWORD=Dawaa-Platform-2026!

ANALYTICS_SERVICE_TOKEN=change-me-analytics-service-token
ANALYTICS_URL=http://127.0.0.1:8000

# Leave empty until Redis is installed locally. Health reports redis as disabled.
REDIS_URL=

API_PORT=4190
WEB_ORIGIN=http://127.0.0.1:4188
ADMIN_ORIGIN=http://127.0.0.1:5174
PRINT_BRIDGE_PORT=9101
LOG_LEVEL=info
